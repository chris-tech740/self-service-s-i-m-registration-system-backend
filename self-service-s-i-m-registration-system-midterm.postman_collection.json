                                "{{REPLACE_WITH_UUID_FROM_GET_sim_types_all}}"
                            ]
                        },
                        "description": "Requirement D3: Adds SimType to agent. Replace agent UUID from GET /api/registration-agents/all and SimType UUID from GET /api/sim-types/all."
                    }
                },
                {
                    "name": "D3 - Add SimType Conflict (409 Error)",
                    "request": {
                        "method": "PUT",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/registration-agents/{{REPLACE_WITH_AGENT_UUID_FROM_GET_registration_agents_all}}/sim-types/{{REPLACE_WITH_UUID_FROM_GET_sim_types_all}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "registration-agents",
                                "{{REPLACE_WITH_AGENT_UUID_FROM_GET_registration_agents_all}}",
                                "sim-types",
                                "{{REPLACE_WITH_UUID_FROM_GET_sim_types_all}}"
                            ]
                        },
                        "description": "Demonstrates 409 Conflict error: The registration agent already has that sim type."
                    }
                },
                {
                    "name": "D4 - Move Agent Service Desk (Success 200)",
                    "request": {
                        "method": "PATCH",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/registration-agents/{{REPLACE_WITH_AGENT_UUID_FROM_GET_registration_agents_all}}/service-desk?deskNumber=4",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "registration-agents",
                                "{{REPLACE_WITH_AGENT_UUID_FROM_GET_registration_agents_all}}",
                                "service-desk"
                            ],
                            "query": [
                                {
                                    "key": "deskNumber",
                                    "value": "4"
                                }
                            ]
                        },
                        "description": "Requirement D4: Reassigns agent to free desk 4. Replace agent UUID from GET /api/registration-agents/all."
                    }
                },
                {
                    "name": "D4 - Move Agent Desk Taken (409 Error)",
                    "request": {
                        "method": "PATCH",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/registration-agents/{{REPLACE_WITH_AGENT_UUID_FROM_GET_registration_agents_all}}/service-desk?deskNumber=2",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "registration-agents",
                                "{{REPLACE_WITH_AGENT_UUID_FROM_GET_registration_agents_all}}",
                                "service-desk"
                            ],
                            "query": [
                                {
                                    "key": "deskNumber",
                                    "value": "2"
                                }
                            ]
                        },
                        "description": "Demonstrates 409 Conflict error: That service desk is taken by another registration agent."
                    }
                }
            ]
        },

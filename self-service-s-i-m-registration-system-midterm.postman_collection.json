        {
            "name": "Part D - Business Rules (D1 to D4)",
            "item": [
                {
                    "name": "D1 - Safe Saving (Success 201)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/sim-registrations/save",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "sim-registrations",
                                "save"
                            ]
                        },
                        "description": "Requirement D1: Safe saving forces status to SUBMITTED even if APPROVED is passed. Replace customer and agent UUIDs.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"registrationDate\": \"2026-11-28\",\n    \"simNumber\": \"0788334455\",\n    \"status\": \"APPROVED\",\n    \"customer\": {\n        \"id\": \"{{REPLACE_WITH_CUSTOMER_UUID_FROM_GET_customers_all}}\"\n    },\n    \"agent\": {\n        \"id\": \"{{REPLACE_WITH_AGENT_UUID_FROM_GET_registration_agents_all}}\"\n    }\n}"
                        }
                    }
                },
                {
                    "name": "D1 - Safe Saving Past Date (400 Error)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/sim-registrations/save",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "sim-registrations",
                                "save"
                            ]
                        },
                        "description": "Demonstrates 400 Bad Request error: Sim registration date cannot be in the past.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"registrationDate\": \"2025-01-01\",\n    \"simNumber\": \"0788334455\"\n}"
                        }
                    }
                },
                {
                    "name": "D1 - Safe Saving Agent Already Has Review (409 Error)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/sim-registrations/save",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "sim-registrations",
                                "save"
                            ]
                        },
                        "description": "Demonstrates 409 Conflict error: Agent already has a registration to review on that date.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"registrationDate\": \"2026-11-02\",\n    \"simNumber\": \"0788778899\",\n    \"agent\": {\n        \"id\": \"{{REPLACE_WITH_AGENT_UUID_FROM_GET_registration_agents_all}}\"\n    }\n}"
                        }
                    }
                },
                {
                    "name": "D2 - Status Flow Update (Success 200)",
                    "request": {
                        "method": "PATCH",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/sim-registrations/{{REPLACE_WITH_SUBMITTED_REGISTRATION_UUID_FROM_GET_sim_registrations_all}}/status?status=UNDER_REVIEW",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "sim-registrations",
                                "{{REPLACE_WITH_SUBMITTED_REGISTRATION_UUID_FROM_GET_sim_registrations_all}}",
                                "status"
                            ],
                            "query": [
                                {
                                    "key": "status",
                                    "value": "UNDER_REVIEW"
                                }
                            ]
                        },
                        "description": "Requirement D2: Moves status from SUBMITTED to UNDER_REVIEW. Replace UUID from GET /api/sim-registrations/by-status?status=SUBMITTED."
                    }
                },
                {
                    "name": "D2 - Status Flow Invalid Move (400 Error)",
                    "request": {
                        "method": "PATCH",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/sim-registrations/{{REPLACE_WITH_APPROVED_REGISTRATION_UUID_FROM_GET_sim_registrations_all}}/status?status=SUBMITTED",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "sim-registrations",
                                "{{REPLACE_WITH_APPROVED_REGISTRATION_UUID_FROM_GET_sim_registrations_all}}",
                                "status"
                            ],
                            "query": [
                                {
                                    "key": "status",
                                    "value": "SUBMITTED"
                                }
                            ]
                        },
                        "description": "Demonstrates 400 Bad Request error: Cannot change status from APPROVED to SUBMITTED."
                    }
                },
                {
                    "name": "D3 - Add SimType to Agent (Success 200)",
                    "request": {
                        "method": "PUT",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/registration-agents/{{REPLACE_WITH_AGENT_UUID_FROM_GET_registration_agents_all}}/sim-types/{{REPLACE_WITH_UUID_FROM_GET_sim_types_all}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "registration-agents",
                                "{{REPLACE_WITH_AGENT_UUID_FROM_GET_registration_agents_all}}",
